# AA MD Bot Official Support Bot environment example
# Copy to .env on production. deploy.sh creates a secure .env automatically if missing.

NODE_ENV=production
PORT=7000
APP_URL=http://YOUR_ORACLE_PUBLIC_IP
DASHBOARD_URL=http://YOUR_ORACLE_PUBLIC_IP
LOG_LEVEL=info

# MongoDB must stay private. deploy.sh generates a strong password automatically.
MONGODB_URI=mongodb://aamd_support_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:27017/aamd_support?authSource=aamd_support
MONGODB_DB_NAME=aamd_support

# Generate strong secrets with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
ACCESS_KEY_SECRET=Ahsan&ali12:@
# Required for external website access-key API requests. Generate with: openssl rand -hex 32
ACCESS_KEY_ENDPOINT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
# Four independent bot/server URLs. Change only these URLs when each server moves.
ACCESS_KEY_SERVER_1_URL=https://193.122.82.38.nip.io
ACCESS_KEY_SERVER_2_URL=https://141-147-132-189.nip.io
ACCESS_KEY_SERVER_3_URL=https://130-110-123-57.nip.io
ACCESS_KEY_SERVER_4_URL=https://144-24-220-107.nip.io
COOKIE_SECURE=false

# Initial owner admin. Change before production login.
ADMIN_EMAIL=owner@aamdbot.com
ADMIN_PASSWORD=ChangeMe2026!

SUPPORT_NUMBER=+923316041183
BOT_NAME=AA MD BOT

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
SESSION_TIMEOUT_MINUTES=10
BACKUP_KEEP=7
