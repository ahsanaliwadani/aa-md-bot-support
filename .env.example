# ──────────────────────────────────────────────
# AA MD Bot Support — Environment Configuration
# ──────────────────────────────────────────────

# Application
NODE_ENV=production
PORT=3000
DASHBOARD_URL=https://support.example.com
APP_URL=https://support.example.com
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://aamduser:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:27017/aamd_support?authSource=aamd_support
MONGODB_DB_NAME=aamd_support

# Auth
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
COOKIE_SECURE=true

# Initial Owner Admin (set on first deploy, then change in dashboard)
ADMIN_EMAIL=owner@aamdbot.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# AA MD Bot Info
SUPPORT_NUMBER=+923316041183
BOT_NAME=AA MD BOT

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Session
SESSION_TIMEOUT_MINUTES=10
BACKUP_KEEP=7
